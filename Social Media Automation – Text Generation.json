    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a social media content assistant.\n\nCreate a short, professional LinkedIn-style post based on this article.\n\nTitle: {{$json.title}}\nSummary: {{$json.contentSnippet}}\n",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        -1904,
        0
      ],
      "id": "d2607776-eaae-496b-ba06-8e921296005b",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\n\n// Datamuse returns an array inside json, so flatten i\nconst hashtags = input\n  .flatMap(item => Array.isArray(item.json) ? item.json : [item.json])\n  .map(obj => obj.word)\n  .filter(word => typeof word === 'string' && word.length > 2)\n  .slice(0, 5)\n  .map(word => `#${word.replace(/\\s+/g, '')}`)\n  .join(' ');\n\nreturn [\n  {\n    json: {\n      hashtags\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1296,
        32
      ],
      "id": "9702d3c2-ddb2-4bac-a113-8e3f2b43685b",
      "name": "Format Hashtags"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1️⃣ Read AI Agent output SAFELY\nconst aiText = $node[\"AI Agent\"].json.output;\n\n// 2️⃣ Read GLOBAL hashtags\nconst hashtags = $node[\"Format Hashtags\"].json.hashtags || \"\";\n\n// 3️⃣ Safety check\nif (!aiText) {\n  return {\n    json: {\n      tweet: \"⚠️ AI output missing\"\n    }\n  };\n}\n\n// 4️⃣ Merge for Twitter\nreturn {\n  json: {\n    tweet: `${aiText}\\n\\n${hashtags}`\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
